# Per-user runtime data — never committed
data/

# Node
node_modules/
.pnp.*
.yarn/cache
.yarn/install-state.gz

# Build artifacts (app/dist is intentionally committed; this catches stray builds)
.vite/
*.tsbuildinfo
# tsc emits these when composite: true in tsconfig.node.json — not source
app/vite.config.d.ts
app/vite.config.js

# Editor/OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
